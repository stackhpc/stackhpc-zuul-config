---
# Secrets for externally managed ZooKeeper/DB, values come from vault
zuul_external_secrets:
  - name: zuul-db
    data:
      dburi: "{{ ('mysql+pymysql://zuul:' ~ zuul_db_password ~ '@db-cluster-haproxy/zuul') | b64encode }}"
  - name: zuul-db-user
    data:
      password: "{{ zuul_db_password | b64encode }}"
  # Must match the keystore password of the cluster the project keys were
  # exported from, otherwise imported keys can't be decrypted
  - name: zuul-keystore
    data:
      password: "{{ zuul_keystore_password | b64encode }}"
