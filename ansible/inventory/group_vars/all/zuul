---
# Address other hosts use to reach this one (ZooKeeper, MariaDB, zuul-web,
# executor log streaming).
zuul_internal_address: "{{ ansible_host | default(inventory_hostname) }}"

zuul_version: "14.2.0"
nodepool_version: "11.0.0"

zuul_fqdn: zuul.stackhpc.com
zuul_proxy_acme_email: ci@stackhpc.com

zuul_auth:
  google_auth:
    default: "true"
    driver: OpenIDConnect
    realm: stackhpc
    issuer_id: "https://accounts.google.com"
    client_id: "161754685259-nvqgt0hruifde3415k3c7r42sob7cof0.apps.googleusercontent.com"
    uid_claim: email
    scope: "openid profile email"

zuul_connections:
  github:
    driver: github
    server: github.com
    app_id: "{{ zuul_github_app_id }}"
    app_key: /etc/zuul/github.key
    webhook_token: "{{ zuul_github_webhook_token }}"
  github-git:
    driver: git
    baseurl: https://github.com
  opendev:
    driver: git
    baseurl: https://opendev.org
  stackhpc:
    driver: git
    baseurl: https://github.com/stackhpc
    canonical_hostname: github.stackhpc.com
  smslab:
    driver: openstack
    cloud: smslab

zuul_executor_config:
  disk_limit_per_job: 5000

zuul_merger_config:
  git_http_low_speed_time: 360
  git_timeout: 600
